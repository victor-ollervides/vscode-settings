        "command": "runCommands",
        "args": {
            "commands": [
                {
                    "command": "cursorMove",
                    "args": {
                        "to": "wrappedLineStart",
                        "select": false
                    }
                },
                {
                    "command": "cursorMove",
                    "args": {
                        "to": "wrappedLineEnd",
                        "select": true
                    }
                },
                {
                    "command": "editor.action.insertSnippet",
