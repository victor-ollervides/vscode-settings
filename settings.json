    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "property.readonly": {
            },
            "function.defaultLibrary": {
                "bold": true,
            },
            // console.log
            // "variable.defaultLibrary": "#4EC9B0",
            "variable.defaultLibrary": {
                "foreground": "#5a76ff",
                "fontStyle": "bold"
            },
            "entity.name.type.module.js": {
                "foreground": "#ff7b00"
            },
            "meta.embedded.expression.js": {
                "foreground": "#00c4f5"
            },
        }
    },
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#000"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#fff"
                    }
                }
            ]
        },
        "[Night Coder Gray Contrast]": {
            "textMateRules": [
                {
                    "scope": "variable.defaultLibrary",
                    "settings": {
                        "foreground": "#7bff00"
                    }
                }
            ]
        },
        "[Dracula Refined]": {},
        "[Snazzy Operator]": {},
        "[Monokai]": {
            "textMateRules": [
                {
                    "scope": [
                        "punctuation.quasi.element",
                        "punctuation.definition.string.begin",
                        "punctuation.definition.string.end",
                        "punctuation.definition.quasi.begin",
                        "punctuation.definition.quasi.end"
                    ],
                    "settings": {
                        "foreground": "#00c4f5"
                    }
                },
                {
                    "scope": "string.unquoted",
                    "settings": {
                        "foreground": "#21e2d2"
                    }
                },
                {
                    "scope": "variable.parameter",
                    "settings": {
                        "fontStyle": ""
                    }
                }
            ]
        },
        "textMateRules": []
    },
    "editor.wordWrap": "off",
    "diffEditor.wordWrap": "off",
    /*
    Editor › Inlay Hints: Enabled value
    *on - Inlay hints are enabled.
    *off - Inlay hints are disabled.
    *onUnlessPressed - Inlay hints shown and hidden with Ctrl+Alt.
    *offUnlessPressed - Inlay hints hidden and shown with Ctrl+Alt.
    */
    "editor.inlayHints.enabled": "offUnlessPressed",
    "oneDarkPro.vivid": true,

    // Custom CSS and JS Loader  v7.1.0
    // be5invis.vscode-custom-css
    "vscode_custom_css.imports": [
        "file:///C:/repos/vscode/User/css/bigger-icons.css"
    ],
    "editor.fontFamily": "'CaskaydiaCove Nerd Font', Operator Mono Lig, 'MesloLGM Nerd Font', Fira Code Medium, Dank Mono, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 13, // 11.5 │ 12 │ 13 │ 13.5
    "editor.lineHeight": 18, // 18 │ 24 for Operator Mono Lig
    "editor.letterSpacing": 0.1,
    "files.trimTrailingWhitespace": true,
    "editor.fontWeight": "400",
    "editor.fontLigatures": true,

    //"css.lint.emptyRules": "ignore",
    "editor.codeActionsOnSave": {
        "source.fixAll": "never",
        // "source.fixAll.eslint": true,
        // "source.addMissingImports": true
    },

    "editor.bracketPairColorization.enabled": true,
    // "editor.bracketPairColorization.colorize": true,
    // "editor.bracketPairColorization.colorize.enabled": true,
    // "editor.bracketPairColorization.colorize.style": "underline",
    "editor.guides.bracketPairs": "active", // true | false | "active"
    //* Controls whether horizontal bracket pair guides are enabled or not.
    //? https://code.visualstudio.com/docs/getstarted/settings
    //  - true: Enables horizontal guides as addition to vertical bracket pair guides.
    //  - active: Enables horizontal guides only for the active bracket pair.
    //  - false: Disables horizontal bracket pair guides.
    "editor.guides.bracketPairsHorizontal": "active",
    // - Prefer showing hovers above the line, if there's space.
    "editor.hover.above": false,
    // "editor.guides.bracketPairsVertical": true,   // true "active"
    "editor.guides.highlightActiveBracketPair": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": false,
    // "editor.guides.highlightActiveGuide": true,
    // "editor.guides.highlightActiveGuide.color": "#ffa24b",
    // "editor.guides.renderGuideLines": false,
    "editor.guides.highlightActiveIndentation": "always", // "always" true "active"
    "editor.renderControlCharacters": true,

    "highlight-matching-tag.highlightSelfClosing": true,
    "highlight-matching-tag.customEmptyElements": [
        "custom",
        "no-content"
    ],
    "highlight-matching-tag.styles": {
        "opening": {
            "left": {
                "surround": "#155FFA"
            },
            "right": {
                "surround": "#155FFA"
            },
            "name": {
                "highlight": "#a200ff54"
            }
        },
        "closing": {
            "left": {
                "surround": "#155FFA"
            },
            "right": {
                "surround": "#155FFA"
            },
            "name": {
                "highlight": "#a200ff54"
            },
            "full": {
                "custom": {
                    "dark": {
                        "borderWidth": "0 0 1px 0",
                        "borderColor": "white",
                        "borderStyle": "solid",
                        "borderRadius": "4px",
                        "right": "10px"
                    },
                    "light": {
                        "borderWidth": "0 0 1px 0",
                        "borderColor": "brown",
                        "borderStyle": "solid",
                        "borderRadius": "4px",
                        "right": "10px"
                    }
                }
            }
        }
    },
