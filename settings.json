    // Configure `glob patterns` for excluding files and folders in fulltext searches and file search in quick open.
    // To exclude files from the recently opened list in quick open, patterns must be absolute (for example **/node_modules/**).
    // Inherits all glob patterns from the #files.exclude# setting.
    //░ This setting tells VS Code's search feature which folders to ignore.
    //░ By setting `**/.next` and `**/node_modules` to `true`, you're explicitly excluding them from all search queries.
    "search.exclude": {
        "**/.next": true,
        "**/node_modules": true,
        // "**/*.bak": false
    },
    //⁄ Configure `glob patterns` for excluding files and folders. For example, the File Explorer decides which files and folders to show or hide based on this setting.
    //⁄ Refer to the ─ search.exclude ─ setting to define search-specific excludes.
    //⁄ Refer to the ─ explorer.excludeGitIgnore ─ setting for ignoring files based on your .gitignore
    //░ * `files.exclude`: This setting controls which files and folders are visible in the Explorer sidebar.
    //░ While you want to hide `.next` and `node_modules` for a cleaner workspace, you must ensure `.env` is not excluded.
    //░ Setting `"**/.env": false` overrides any default exclusion and makes sure it remains visible and searchable.
    "files.exclude": {
        "**/.next": true,
        "**/node_modules": true,
        "**/.env": false,
    },
