    "prettier.singleQuote": true,
    "prettier.bracketSpacing": true,
    "prettier.jsxSingleQuote": true,
    "js/ts.preferences.quoteStyle": "single", // -> "auto" | "single" | "double"
    "html.completion.attributeDefaultValue": "singlequotes",
    "prettier.useTabs": true,
    "prettier.tabWidth": 4,
    "prettier.bracketSameLine": true,
    // "js/ts.validate.enable": false,
    // "vscode.typescript-language-features": false,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
        // "editor.defaultFormatter": "vscode.json-language-features" // JSON Languages Features
        // "editor.defaultFormatter": "esbenp.prettier-vscode" // Prettier - Code formatter
    },

    "[plaintext]": {
        "editor.language.colorizedBracketPairs": [
            [
                "(",
                ")"
            ],
            [
                "[",
                "]"
            ],
            [
                "{",
                "}"
            ],
            [
                "<",
                ">"
            ],
            [
                "BEGIN",
                "END"
            ],
            [
                "begin",
                "end"
            ],
            [
                "case",
                "esac"
            ],
            [
                "do",
                "done"
            ],
            [
                "for",
                "done"
            ],
            [
                "select",
                "done"
            ],
            [
                "while",
                "done"
            ]
        ]
    },
    "editor.cursorBlinking": "solid", // solid | phase | expand | blink |
    "editor.cursorStyle": "block", //  | block | block-outline │ line │ line-thin │ underline │ underline-thin
    "editor.cursorWidth": 1,

