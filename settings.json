    "workbench.iconTheme": "material-icon-theme",

    "breadcrumbs.enabled": true,
    "synthwave84.brightness": 1,
    "terminal.external.windowsExec": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    "terminal.integrated.profiles.windows": {
        "Cygwin": {
            // C:\cygwin64\bin\bash.exe
            "path": "C:\\cygwin64\\Cygwin.bat",
            "args": [
                "--login",
                "-i"
            ],
            "icon": "coffee",
            "overrideName": true
        },
        //▓ DO NOT USE
        // "WindowsPowerShell": {
        //     "path": "powershell .exe",
        //     "args": [],
        //     "icon": "terminal-powershell",
        //     "overrideName": true
        // },
        "pwsh": {
            "path": "pwsh.exe",
            "args": [],
            "icon": "terminal-powershell",
            "overrideName": true
        },
        "pwsh 7 Admin (External)": {
            "path": "pwsh.exe",
            "args": ["-Command", "Start-Process", "pwsh.exe", "-Verb", "RunAs", "-ArgumentList", "'-NoExit', '-Command', 'Set-Location \"${workspaceFolder}\"'"],
            "icon": "shield",
            "overrideName": true
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd",
            "overrideName": true,
        },
        "Git Bash": {
            "source": "Git Bash",
            "overrideName": true,
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ],
            "icon": "logo-github",
            "color": "terminal.ansiMagenta"
        },
        "MSYS2": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "MSYSTEM": "MINGW64",
                "CHERE_INVOKING": "1"
            },
            // "icon": "terminal"
            "icon": "keyboard",
            "overrideName": true
        },
        "MINGW64": {
            "path": "C:\\msys64\\msys2_shell.cmd",
            "args": [
                "-defterm",
                "-here",
                "-no-start",
                "-mingw64"
            ],
            // "icon": "terminal-bash",
            // "icon": "symbol-misc",
            "icon": "terminal",
            "overrideName": true
        },
        "Nushell": {
            "path": "nu.exe",
            "args": [],
            // "icon": "terminal-bash",
            "icon": "rocket",
            "overrideName": true,
            "color": "terminal.ansiGreen"
        },
        "SSH Remote CMD": {
        "path": "C:\\Windows\\System32\\cmd.exe",
        "args": ["/k", "ssh", "babad@172.24.199.229"]
        },
        "SSH Remote": {
            "path": "pwsh.exe",
            // "args": ["-NoExit", "-Command", "ssh babad@172.24.199.229"]
            //░ OmarchyVM server config (IP address & User) is defined in C:\Users\USERNAME\.ssh\config
            "args": ["-NoExit", "-Command", "ssh OmarchyVM"]
        },
    },
